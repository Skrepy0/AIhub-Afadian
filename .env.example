# 爱发电开发者id
AFDIAN_USER_ID=
# 爱发电开发者token
AFDIAN_TOKEN=
# 你的 new-api 网址
NEW_API_BASE_URL=
# new-api 管理员的访问令牌
NEW_API_ADMIN_TOKEN=
# 默认给的额度(订单金额解析失败时使用)
DEFAULT_QUOTA=
# 额度比率
QUOTA_RATE=
# Bearer 验证是否生效, 生产环境建议关闭, 仅测试时使用
ENABLE_BEARER_AUTH=false
# 爱发电公钥, 可在官方文档中找到
AFDIAN_PUBLIC_KEY=
# 是否启用邮件提醒
ENABLE_EMAIL_WARNING=true
# SMTP 主机
SMTP_HOST=
# SMTP 端口
SMTP_POST=
# 用户名
SMTP_USER=
# 访问密钥
SMTP_PASSWORD=
# 发件地址
SMTP_FROM=
# 接受警告信息的邮箱, 若有多个邮箱则用逗号或分号分隔(英文符号)
WARNING_EMAIL=