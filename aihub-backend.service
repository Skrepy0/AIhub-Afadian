[Unit]
Description=AIhub Afdian Backend Service
After=network.target
Wants=network.target

[Service]
Type=simple
User=aihub
Group=aihub
WorkingDirectory=/home/aihub/AIhub-Afadian
Environment="PATH=/home/aihub/AIhub-Afadian/.venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONUNBUFFERED=1"
EnvironmentFile=/home/aihub/AIhub-Afadian/.env
ExecStart=/home/aihub/AIhub-Afadian/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target